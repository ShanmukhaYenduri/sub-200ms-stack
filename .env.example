# Copy to .env when running the app outside Docker Compose.
# Nothing in here is a real secret. Anything real belongs in a secret manager,
# not in a file that ships with the repo.

PORT=3000

DATABASE_URL=postgres://metrics:metrics@localhost:5432/metrics
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

# The topic the API produces to and the consumer reads from. Both sides read it
# from here, because a topic name that disagrees between producer and consumer
# fails silently rather than loudly.
KAFKA_TOPIC=metric-events

JWT_SECRET=local-dev-only-not-a-real-secret

# How stale a cached metrics response is allowed to be, in seconds.
# This is the staleness window we are explicitly choosing to accept, not a
# number someone picked because it looked round.
CACHE_TTL_SECONDS=30

# Token bucket: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_SECONDS, per
# authenticated subject (falling back to IP when unauthenticated).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60

# Pool ceiling. Kept well under the Postgres max_connections so that N app
# instances cannot collectively exhaust the database.
PG_POOL_MAX=20
